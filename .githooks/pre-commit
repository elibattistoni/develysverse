#!/usr/bin/env bash
# Pre-commit checks for develysverse. Git runs this before every commit.
# It is enabled by `npm ci` / `npm install` (the "prepare" script sets core.hooksPath).
# Skipping it once is possible with `git commit --no-verify`, but CI runs the same kind of checks.
set -u -o pipefail # pipefail: a failed `git show` in a pipeline fails the check too

# 1. Secrets: block the commit if the staged changes contain a key, token or password.
if command -v gitleaks >/dev/null 2>&1; then
  # --redact hides the secret value in the output; --verbose shows file, line and rule.
  if ! gitleaks git --staged --redact --verbose --no-banner --log-level warn; then
    echo "pre-commit: gitleaks found a possible secret in the staged changes (details above)." >&2
    echo "pre-commit: remove it from the files. If it was a real key, rotate it (create a new one, revoke the old one)." >&2
    exit 1
  fi
else
  echo "pre-commit: gitleaks is not installed, so the secret scan was skipped (macOS: brew install gitleaks)." >&2
fi

# Steps 2 and 3 check the staged version of each file (what will be committed), not the copy on
# disk: `git show ":file"` prints the staged content, and the tools read it from standard input.
# This way an unstaged fix can't hide a staged problem, and an unstaged edit can't block a good commit.
# File names are read NUL-separated (-z), so a name with spaces stays one path.

# The list goes to a temporary file first: if git diff failed inside `< <(…)`, the loop would just
# see an empty list and the commit would pass unchecked. This way a failure stops the commit.
staged_list=$(mktemp) || exit 1
trap 'rm -f "$staged_list"' EXIT
staged_files() {
  if ! git diff --cached --name-only -z --diff-filter=ACMR -- "$@" >"$staged_list"; then
    echo "pre-commit: could not list the staged files." >&2
    exit 1
  fi
}

# Stop the commit if git can't read the staged version of a file (better than checking nothing).
require_staged() {
  if ! git cat-file -e ":$1" 2>/dev/null; then
    echo "pre-commit: could not read the staged version of \"$1\"." >&2
    exit 1
  fi
}

# 2. Lint: run ESLint on the staged JavaScript/TypeScript files.
if [ -x node_modules/.bin/eslint ]; then
  failed=0
  staged_files '*.js' '*.jsx' '*.mjs' '*.cjs' '*.ts' '*.tsx'
  while IFS= read -r -d '' file; do
    require_staged "$file"
    git show ":$file" | node_modules/.bin/eslint --no-warn-ignored --stdin --stdin-filename "$file" || failed=1
  done <"$staged_list"
  if [ "$failed" -ne 0 ]; then
    echo "pre-commit: ESLint found problems in the staged files (details above)." >&2
    exit 1
  fi
else
  echo "pre-commit: node_modules is missing, so ESLint was skipped (run npm ci)." >&2
fi

# 3. Format: check the staged files with Prettier (fix with: npm run format).
if [ -x node_modules/.bin/prettier ]; then
  unformatted=()
  staged_files
  while IFS= read -r -d '' file; do
    require_staged "$file"
    git show ":$file" | node_modules/.bin/prettier --check --ignore-unknown --stdin-filepath "$file" >/dev/null 2>&1 ||
      unformatted+=("$file")
  done <"$staged_list"
  if [ "${#unformatted[@]}" -ne 0 ]; then
    printf '%s\n' "${unformatted[@]}" >&2
    echo "pre-commit: these staged files are not formatted. Run npm run format, then git add them again." >&2
    exit 1
  fi
else
  echo "pre-commit: node_modules is missing, so the format check was skipped (run npm ci)." >&2
fi

exit 0
